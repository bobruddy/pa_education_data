FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY pa_edu ./pa_edu
COPY sql ./sql
COPY sources ./sources
RUN pip install --no-cache-dir .

ENV PDE_ROOT=/app
ENV PDE_DATA=/var/pde
ENV PDE_DATA_PORT=8091
ARG PDE_GIT_SHA=
ENV PDE_GIT_SHA=${PDE_GIT_SHA}
EXPOSE 8091

CMD ["python", "-m", "pa_edu.serve"]
